{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/solarcell1475/hfss-microstrip-results/dr-strange-engine/schemas/tuning-session.schema.json",
  "title": "Dr Strange Engine tuning session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "structure",
    "accepted_baseline",
    "rounds"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "structure": {
      "$ref": "#/$defs/structure"
    },
    "accepted_baseline": {
      "$ref": "#/$defs/baseline"
    },
    "rounds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/round"
      }
    }
  },
  "$defs": {
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameter_id",
        "display_name",
        "location",
        "current",
        "editable"
      ],
      "properties": {
        "parameter_id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string"
        },
        "current": {
          "$ref": "#/$defs/quantity"
        },
        "allowed_min": {
          "$ref": "#/$defs/quantity"
        },
        "allowed_max": {
          "$ref": "#/$defs/quantity"
        },
        "editable": {
          "type": "boolean"
        },
        "linked_parameters": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structure_id", "family", "parameters"],
      "properties": {
        "structure_id": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "parameters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "preset_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "metric_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "operator", "target", "unit"],
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "enum": [
            "less_than",
            "less_than_or_equal",
            "greater_than",
            "greater_than_or_equal",
            "equal",
            "maximize",
            "minimize",
            "within"
          ]
        },
        "target": {
          "type": ["number", "array"],
          "items": {
            "type": "number"
          }
        },
        "unit": {
          "type": "string"
        },
        "frequency": {
          "$ref": "#/$defs/quantity"
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch_id", "model_hash", "result_refs"],
      "properties": {
        "branch_id": {
          "type": "string"
        },
        "model_hash": {
          "type": "string"
        },
        "result_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "choice_id",
        "label",
        "direction",
        "parameters",
        "rationale",
        "confidence",
        "reversible"
      ],
      "properties": {
        "choice_id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "direction": {
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rationale": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_responses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tradeoffs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "experiment_strategy": {
          "enum": [
            "intuition",
            "local_sweep",
            "coupled_sweep",
            "doe",
            "optimizer",
            "preset",
            "custom",
            "stop"
          ]
        },
        "estimated_solver_runs": {
          "type": "integer",
          "minimum": 0
        },
        "confidence": {
          "enum": ["low", "medium", "high"]
        },
        "reversible": {
          "type": "boolean"
        }
      }
    },
    "candidate_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "solver_status",
        "mini_target_pass",
        "guardrails_pass",
        "result_refs"
      ],
      "properties": {
        "candidate_id": {
          "type": "string"
        },
        "solver_status": {
          "enum": ["not_run", "running", "converged", "failed"]
        },
        "mini_target_pass": {
          "type": "boolean"
        },
        "guardrails_pass": {
          "type": "boolean"
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "result_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "human_confirmed"],
      "properties": {
        "action": {
          "enum": [
            "accept",
            "refine",
            "revert",
            "switch_direction",
            "modify_target",
            "custom",
            "stop"
          ]
        },
        "candidate_id": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        },
        "human_confirmed": {
          "const": true
        }
      }
    },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "round_id",
        "state",
        "mini_target",
        "global_guardrails",
        "choices"
      ],
      "properties": {
        "round_id": {
          "type": "string"
        },
        "state": {
          "enum": [
            "understand_structure",
            "choose_mini_target",
            "confirm_guardrails",
            "awaiting_choice",
            "planning",
            "preflight",
            "running",
            "evaluating",
            "awaiting_decision",
            "completed",
            "reverted"
          ]
        },
        "mini_target": {
          "$ref": "#/$defs/metric_rule"
        },
        "global_guardrails": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metric_rule"
          }
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/choice"
          }
        },
        "selected_choice_id": {
          "type": "string"
        },
        "human_choice_confirmed": {
          "type": "boolean"
        },
        "candidate_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate_result"
          }
        },
        "decision": {
          "$ref": "#/$defs/decision"
        }
      }
    }
  }
}
